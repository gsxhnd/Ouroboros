    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "d3": "^7.9.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.43.0",
    "motion": "^14.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.13",
    "react-resizable-panels": "^4.12.4",
    "react-router": "^8.5.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/d3": "^7.4.3",
